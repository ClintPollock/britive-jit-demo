{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyTheDemoBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::britive-jit-demo-696226360299"
    },
    {
      "Sid": "ReadWriteDemoObjectsOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::britive-jit-demo-696226360299/*"
    }
  ]
}
